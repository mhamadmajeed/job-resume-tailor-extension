{
  "manifest_version": 3,
  "name": "ResumePilot",
  "description": "Tailors your saved resume to the job you are viewing with AI, via ResumePilot (resumepilot.co).",
  "version": "2.0.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://resumepilot.co/*"
  ],
  "action": {
    "default_title": "Tailor resume",
    "default_popup": "popup.html"
  }
}
